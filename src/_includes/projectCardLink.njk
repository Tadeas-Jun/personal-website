<div class="my-5 project-card-link mx-md-3 my-md-3">
	<h2 class="display-4 article-title" data-i18n="{{ project.data.i18nTitle }}">{{ project.data.title }}</h2>
	<p data-i18n="{{ project.data.i18nContent }}">{{ project.content }}</p>
	{% if project.data.primaryButtonText or project.data.secondaryButtonText %}
		<div class="d-flex align-items-center justify-content-start mt-auto mb-2">
			{% if project.data.primaryButtonText %}
				<a href={{ project.data.primaryButtonLink }}" class="btn btn-dark btn-md mx-2" target="_blank" rel="noreferrer" data-i18n="{{ project.data.i18nPrimaryButtonText }}">{{ project.data.primaryButtonText }}</a>
			{% endif %}
			{% if project.data.secondaryButtonText %}
				<a href="{{ project.data.secondaryButtonLink }}" target="_blank" rel="noreferrer" class="btn btn-outline-dark btn-md mx-2" data-i18n="{{ project.data.i18nSecondaryButtonText }}">{{ project.data.secondaryButtonText }}</a>
			{% endif %}
		</div>
	{% endif %}
</div>
