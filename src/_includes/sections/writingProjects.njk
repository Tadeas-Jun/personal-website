<section id="projects" class="bg-light text-dark p-5 px-2 px-sm-5 text-center text-sm-start">
	<div class="container">

		<h2 class="display-3 mt-5" data-i18n="home.projects.worldbuilding.heading">Worldbuilding & writing projects</h2>

		<div class="container pt-3 d-md-flex flex-wrap mb-4">
		{% for project in collections.projects %}
			{% if (project.data.niche == 'writing' or project.data.niche == 'worldbuilding') and project.data.type == 'card' and project.data.shown %}
				{% include 'projectCardLarge.njk' %}
			{% endif %}
		{% endfor %}
		</div>

		{% for project in collections.projects %}
			{% if (project.data.niche == 'writing' or project.data.niche == 'worldbuilding') and project.data.type == 'link' and project.data.shown %}
				{% include 'projectCardLink.njk' %}
			{% endif %}
		{% endfor %}

</section>
