<!DOCTYPE html>
<html lang="en">
  {% include "meta/head.njk" %}
  <body>

    <!-- Navbar -->
    {% include "meta/navbar.njk" %}

    <!-- Alert message, if any -->
    <!-- {% include "meta/alert.njk" %} -->

    <!-- Page content -->
    {% block content %}
      {{ content | safe }}
    {% endblock content %}

    <!-- Footer -->
    {% include "meta/footer.njk" %}

    <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      // Code block pre-processing
      (function () {
        let codeBlocks = document.querySelectorAll('pre > code');
        for (codeBlock of codeBlocks) {
          let codePre = codeBlock.parentNode;
          codePre.classList.add('code');
          let lines = codePre.innerText.split("\n");
          lines.pop();
          while (codePre.childNodes.length > 0) {
            codePre.removeChild(codePre.childNodes[0]);
          }
          for (line of lines) {
            let code = document.createElement("code");
            code.innerText = line;
            codePre.appendChild(code);
            codePre.appendChild(document.createTextNode("\n"));
          }
        }
      })();
    </script>
    <script src="/assets/js/i18n.js"></script>
  </body>
</html>